# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=*

# Database (MongoDB Atlas). From your cluster -> Connect -> Drivers -> copy
# the connection string, then fill in the real password (it is NOT the same
# as your Atlas account password - it's the database user's password, set
# when you created that user under Database Access). A database name is
# required after the host (Mongo won't default one for you) - "algora" here.
DATABASE_URL="mongodb+srv://thealgora99_db_user:<db_password>@cluster0.ghspnoc.mongodb.net/algora?retryWrites=true&w=majority&appName=Cluster0"

# Auth (tenant users - login/signup used by the Flutter app)
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Auth (admin panel - completely separate from the tenant JWT above, so an
# admin token can never be replayed against a tenant route or vice versa)
ADMIN_JWT_SECRET=replace-with-a-different-long-random-string
ADMIN_JWT_EXPIRES_IN=12h

# AES-256 key used to encrypt Page/IG access tokens at rest.
# Must be exactly 32 bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=replace-with-64-hex-chars-32-bytes

# Gmail SMTP - sends login codes & password-reset codes. EMAIL_APP_PASSWORD
# is a Gmail "app password" (Google Account -> Security -> 2-Step
# Verification -> App passwords), NOT the account's real login password.
EMAIL_USER=your-sending-address@gmail.com
EMAIL_APP_PASSWORD=replace-with-16-char-gmail-app-password

# --- Meta (Facebook & Instagram) app credentials ---
# From developers.facebook.com/apps -> your app -> Settings > Basic
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
# Must match a "Valid OAuth Redirect URI" configured in the Meta dashboard,
# and must be publicly reachable (use ngrok in local dev).
META_OAUTH_REDIRECT_URI=http://localhost:4000/api/v1/channels/meta/oauth/callback
# Arbitrary string you choose; Meta echoes it back on webhook verification (GET).
META_WEBHOOK_VERIFY_TOKEN=replace-with-any-random-string
META_GRAPH_API_VERSION=v20.0
