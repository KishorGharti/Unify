generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(cuid()) @map("_id")
  name      String
  createdAt DateTime @default(now())

  users         User[]
  channels      Channel[]
  conversations Conversation[]
}

model User {
  id           String   @id @default(cuid()) @map("_id")
  email        String   @unique
  passwordHash String
  fullName     String
  role         String   @default("agent")
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  createdAt    DateTime @default(now())

  otpCodeHash  String?
  otpExpiresAt DateTime?
  otpAttempts  Int       @default(0)

  hasPassword Boolean @default(false)

  assignedConversations Conversation[] @relation("AssignedAgent")
  messages              Message[]
}

model Channel {
  id                   String    @id @default(cuid()) @map("_id")
  tenantId             String
  tenant               Tenant    @relation(fields: [tenantId], references: [id])
  channelType          String
  authMethod           String    @default("facebook_login")
  accountName          String
  externalId           String
  status               String    @default("active")
  accessTokenEncrypted String
  permissionsGranted   String
  lastWebhookReceived  DateTime?
  connectedAt          DateTime  @default(now())

  conversations Conversation[]

  @@unique([channelType, externalId])
}

model Conversation {
  id                 String    @id @default(cuid()) @map("_id")
  tenantId           String
  tenant             Tenant    @relation(fields: [tenantId], references: [id])
  channelId          String
  channel            Channel   @relation(fields: [channelId], references: [id])
  customerExternalId String
  customerName       String?
  customerAvatarUrl  String?
  status             String    @default("open")
  tags               String    @default("[]")
  assignedAgentId    String?
  assignedAgent      User?     @relation("AssignedAgent", fields: [assignedAgentId], references: [id])
  lastMessageAt      DateTime?
  createdAt          DateTime  @default(now())

  messages Message[]

  @@unique([channelId, customerExternalId])
}

model Message {
  id             String       @id @default(cuid()) @map("_id")
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  direction      String
  senderType     String
  senderAgentId  String?
  senderAgent    User?        @relation(fields: [senderAgentId], references: [id])
  text           String?
  attachmentUrl  String?
  isInternalNote Boolean      @default(false)
  metaMessageId  String?
  createdAt      DateTime     @default(now())
}

model AllowedEmail {
  id            String    @id @default(cuid()) @map("_id")
  email         String    @unique
  note          String?
  addedByAdminId String
  addedByAdmin  AdminUser @relation(fields: [addedByAdminId], references: [id])
  createdAt     DateTime  @default(now())
}

model AdminUser {
  id           String   @id @default(cuid()) @map("_id")
  email        String   @unique
  passwordHash String
  fullName     String
  createdAt    DateTime @default(now())

  allowedEmailsAdded AllowedEmail[]
}
